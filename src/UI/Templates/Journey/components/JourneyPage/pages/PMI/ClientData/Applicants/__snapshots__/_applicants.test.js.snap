    font-size: calc(14px + (16 - 14) * (100vw - 400px) / (1200 - 400));
    line-height: calc(16px + (20 - 16) * (100vw - 400px) / (1200 - 400));
  }
}

@media screen and (min-width:1200px) {
  .c38 {
    font-size: 16px;
    line-height: 20px;
  }
}

