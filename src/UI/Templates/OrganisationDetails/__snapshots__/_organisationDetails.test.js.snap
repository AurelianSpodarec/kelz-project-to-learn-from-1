  align-items: center;
  font-size: 2.5rem;
  margin-bottom: 0.5rem;
  -webkit-transition: color 0.2s linear;
  transition: color 0.2s linear;
}

.c26 {
  color: #FFF;
}

.c32 {
  position: absolute;
  z-index: 40;
  width: calc(100vw - 7rem);
  background-color: transparent;
  -webkit-transition: background-color 0.25s linear,opacity 0.25s linear;
  transition: background-color 0.25s linear,opacity 0.25s linear;
  opacity: 0;
}

.c35 {
  border-bottom: 1px solid #EFEFEF;
  margin: 0 0 2rem;
  padding: 0;
}

.c33 {
  display: -webkit-box;
  display: -webkit-flex;
  display: -ms-flexbox;
  display: flex;
  -webkit-box-pack: justify;
  -webkit-justify-content: space-between;
  -ms-flex-pack: justify;
  justify-content: space-between;
}

.c34 {
  width: 80rem;
}

.c49 {
  width: 20rem;
}

.c54 {
  font-size: 1.4rem;
}

.c48 {
  margin-left: 5rem;
}

@media screen and (min-width:400px) {
  .c37 {
    font-size: calc(14px + (20 - 14) * (100vw - 400px) / (1200 - 400));
    line-height: calc(22px + (25 - 22) * (100vw - 400px) / (1200 - 400));
  }
}

@media screen and (min-width:1200px) {
  .c37 {
    font-size: 20px;
    line-height: 25px;
  }
}

@media screen and (min-width:400px) {
  .c50 {
    font-size: calc(12px + (16 - 12) * (100vw - 400px) / (1200 - 400));
    line-height: calc(16px + (20 - 16) * (100vw - 400px) / (1200 - 400));
  }
}

@media screen and (min-width:1200px) {
  .c50 {
    font-size: 16px;
    line-height: 20px;
  }
}

@media screen and (min-width:400px) {
  .c43 {
    font-size: calc(14px + (16 - 14) * (100vw - 400px) / (1200 - 400));
