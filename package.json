{
  "name": "4c-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@4cplatform/elements": "0.8.5",
    "@ckeditor/ckeditor5-build-classic": "^30.0.0",
    "@ckeditor/ckeditor5-react": "^3.0.3",
    "google-map-react": "^2.1.10",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-helmet-async": "^1.1.2",
    "react-router-dom": "^5.3.0",
    "react-scripts": "4.0.3",
    "moment": "^2.29.1"
  },
  "scripts": {
    "postinstall": "find .git/hooks -type f -exec rm {} ';' && find .githooks -type f -exec cp -rf {} .git/hooks/ ';'",
    "start:storybook": "yarn test:output --coverage; cp -rf coverage/ public/coverage/; start-storybook -p 6003",
    "start:portal": "react-scripts start",
    "up:storybook": "rm -rf node_modules && yarn && yarn start:storybook",
    "up:portal": "rm -rf node_modules && yarn && yarn start:portal",
    "test": "react-scripts test --env=jsdom --watchAll=false",
    "test:cover": "rm -rf coverage && rm -rf public/coverage && yarn test --coverage && cp -rf coverage/ public/coverage/",
    "test:output": "yarn test --json --outputFile=.storybook/jest-test-results.json",
    "test:watch": "yarn test:output --watchAll --coverage",
    "test:update": "yarn test:output -u",
    "lint:check": "prettier --check '**/*.json' '**/*.md' '**/*.mdx' && eslint '**/*.js'",
    "lint:fix": "prettier --write '**/*.json' '**/*.md' '**/*.mdx' && eslint --fix '**/*.js'",
    "build:storybook": "yarn test:output --coverage && cp -rf coverage/ public/coverage/ && yarn build-storybook -o ./storybook_build",
    "build:portal": "rm -rf public/coverage && react-scripts build",
    "update-readme": "cp -f README.md node_modules/outer-scope"
  },
  "jest": {
    "transform": {
      "^.+\\.js?$": "babel-jest",
      "^.+\\.mdx?$": "@storybook/addon-docs/jest-transform-mdx"
    },
    "coverageReporters": [
      "html"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/UI/Info/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 20,
        "functions": 20,
        "lines": 40,
        "statements": 20
      }
    },
    "moduleNameMapper": {
      ".+\\.(css|styl|less|sass|scss)$": "identity-obj-proxy",
      ".+\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/src/__mocks__/fileMock.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "watchPathIgnorePatterns": [
      "/node_modules/",
      "/dist/",
      "/.storybook/",
      "__snapshots__"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@4cplatform/eslint-config": "github:4C-Platform/eslint-config.git#master",
    "@storybook/addon-actions": "^6.4.8",
    "@storybook/addon-essentials": "^6.4.8",
    "@storybook/addon-jest": "^6.4.8",
    "@storybook/addon-links": "^6.4.8",
    "@storybook/node-logger": "^6.4.8",
    "@storybook/preset-create-react-app": "^3.1.5",
    "@storybook/react": "^6.4.8",
    "@testing-library/dom": "^8.7.2",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.1.2",
    "@testing-library/user-event": "^13.3.0",
    "axios-mock-adapter": "^1.20.0",
    "eslint": "^7.11.0",
    "jest-styled-components": "^7.0.5",
    "outer-scope": "file:.",
    "prettier": "^2.1.1"
  }
}
